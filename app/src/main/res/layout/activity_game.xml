<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/streak"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginBottom="24dp"
            android:max="5"
            android:progress="0"
            android:progressDrawable="@drawable/progress_streak" />

        <TextView
            android:id="@+id/tvCombo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_combo_chip"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="@font/fredoka_bold"
                    android:gravity="center"
                    android:text="How many?"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="🍎 🍎 🍎"
                    android:textSize="46sp" />

                <TextView
                    android:id="@+id/tvFeedbackMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp"
                    android:fontFamily="@font/fredoka_bold"
                    android:textColor="#FF5722"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOption1"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="10dp"
                android:fontFamily="@font/fredoka_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="2"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@color/option_orange"
                app:cornerRadius="44dp"
                app:elevation="4dp" />

            <Button
                android:id="@+id/btnOption2"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="10dp"
                android:fontFamily="@font/fredoka_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="3"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@color/option_green"
                app:cornerRadius="44dp"
                app:elevation="4dp" />

            <Button
                android:id="@+id/btnOption3"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="10dp"
                android:fontFamily="@font/fredoka_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="5"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@color/option_blue"
                app:cornerRadius="44dp"
                app:elevation="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <!-- Total Text (Stacked on top) -->
            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Your total: 0"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/fredoka_bold"
                android:textSize="24sp"
                android:visibility="gone" />

            <!-- +10 and +1 Buttons (Horizontal row below text) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAdd10"
                    android:layout_width="100dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/fredoka_bold"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="+10"
                    app:cornerRadius="32dp"
                    android:backgroundTint="#3AA0FF"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnAdd1"
                    android:layout_width="100dp"
                    android:layout_height="64dp"
                    android:fontFamily="@font/fredoka_bold"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="+1"
                    app:cornerRadius="32dp"
                    android:backgroundTint="#FF6F59"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/layoutBadgeReward"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/surface"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/badgeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_bold"
            android:text="🌟 Super Star! 🌟"
            android:textColor="#FF9800"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/badgeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/fredoka_bold"
            android:text="You unlocked a new badge!"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/fredoka_bold"
            android:text="Awesome!"
            app:backgroundTint="#4CAF50"
            app:cornerRadius="20dp" />
    </LinearLayout>


</FrameLayout>